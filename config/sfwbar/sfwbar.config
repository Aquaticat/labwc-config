module("pulsectl")

function("ToggleMinimize") {
  [!Minimized] Minimize
  [Minimized] UnMinimize
}

function("ToggleMaximize") {
  [!Maximized] Maximize
  [Maximized] UnMaximize
}

menu("winops") {
  item("New instance", Exec "labwc-launcher launch " + WindowInfo("appid"));
  item("(Un)minimize", Function "ToggleMinimize");
  item("(Un)maximize", Function "ToggleMaximize");
  item("Close", Close);
}

scanner {
  ExecClient("/home/user/.local/bin/wlr-pager watch", "pager") {
    PagerActive = RegEx("([^\n]+)")
  }
}

# Interactive calendar popup for the clock (patched copy of the example
# shipped in /usr/share/sfwbar/: adds AutoClose, a today-highlight cell and
# pure-black theming). Deployed to ~/.config/sfwbar/cal.widget.
include("cal.widget")

layout {
  style = "panel"

  image "launcher" {
    value = "/usr/share/icons/breeze-dark/places/64/start-here-kde.svg"
    style = "launcher"
    action[1] = Exec "labwc-launcher toggle"
  }

  grid "pager" {
    style = "pager"
    image {
      value = If($PagerActive="left top","/home/user/.config/sfwbar/cell-focused.svg","/home/user/.config/sfwbar/cell-normal.svg")
      css = "* { min-width: 14px; min-height: 14px; margin: 1px; padding: 0; }"
      tooltip = "left top"
      loc(1,1)
      action[1] = Exec "/home/user/.local/bin/wlr-pager activate 0"
      action[ScrollUp] = Exec "/home/user/.local/bin/wlr-pager prev"
      action[ScrollDown] = Exec "/home/user/.local/bin/wlr-pager next"
    }
    image {
      value = If($PagerActive="top","/home/user/.config/sfwbar/cell-focused.svg","/home/user/.config/sfwbar/cell-normal.svg")
      css = "* { min-width: 14px; min-height: 14px; margin: 1px; padding: 0; }"
      tooltip = "top"
      loc(2,1)
      action[1] = Exec "/home/user/.local/bin/wlr-pager activate 1"
      action[ScrollUp] = Exec "/home/user/.local/bin/wlr-pager prev"
      action[ScrollDown] = Exec "/home/user/.local/bin/wlr-pager next"
    }
    image {
      value = If($PagerActive="right top","/home/user/.config/sfwbar/cell-focused.svg","/home/user/.config/sfwbar/cell-normal.svg")
      css = "* { min-width: 14px; min-height: 14px; margin: 1px; padding: 0; }"
      tooltip = "right top"
      loc(3,1)
      action[1] = Exec "/home/user/.local/bin/wlr-pager activate 2"
      action[ScrollUp] = Exec "/home/user/.local/bin/wlr-pager prev"
      action[ScrollDown] = Exec "/home/user/.local/bin/wlr-pager next"
    }
    image {
      value = If($PagerActive="left","/home/user/.config/sfwbar/cell-focused.svg","/home/user/.config/sfwbar/cell-normal.svg")
      css = "* { min-width: 14px; min-height: 14px; margin: 1px; padding: 0; }"
      tooltip = "left"
      loc(1,2)
      action[1] = Exec "/home/user/.local/bin/wlr-pager activate 3"
      action[ScrollUp] = Exec "/home/user/.local/bin/wlr-pager prev"
      action[ScrollDown] = Exec "/home/user/.local/bin/wlr-pager next"
    }
    image {
      value = If($PagerActive="middle","/home/user/.config/sfwbar/cell-focused.svg","/home/user/.config/sfwbar/cell-normal.svg")
      css = "* { min-width: 14px; min-height: 14px; margin: 1px; padding: 0; }"
      tooltip = "middle"
      loc(2,2)
      action[1] = Exec "/home/user/.local/bin/wlr-pager activate 4"
      action[ScrollUp] = Exec "/home/user/.local/bin/wlr-pager prev"
      action[ScrollDown] = Exec "/home/user/.local/bin/wlr-pager next"
    }
    image {
      value = If($PagerActive="right","/home/user/.config/sfwbar/cell-focused.svg","/home/user/.config/sfwbar/cell-normal.svg")
      css = "* { min-width: 14px; min-height: 14px; margin: 1px; padding: 0; }"
      tooltip = "right"
      loc(3,2)
      action[1] = Exec "/home/user/.local/bin/wlr-pager activate 5"
      action[ScrollUp] = Exec "/home/user/.local/bin/wlr-pager prev"
      action[ScrollDown] = Exec "/home/user/.local/bin/wlr-pager next"
    }
    image {
      value = If($PagerActive="left bottom","/home/user/.config/sfwbar/cell-focused.svg","/home/user/.config/sfwbar/cell-normal.svg")
      css = "* { min-width: 14px; min-height: 14px; margin: 1px; padding: 0; }"
      tooltip = "left bottom"
      loc(1,3)
      action[1] = Exec "/home/user/.local/bin/wlr-pager activate 6"
      action[ScrollUp] = Exec "/home/user/.local/bin/wlr-pager prev"
      action[ScrollDown] = Exec "/home/user/.local/bin/wlr-pager next"
    }
    image {
      value = If($PagerActive="bottom","/home/user/.config/sfwbar/cell-focused.svg","/home/user/.config/sfwbar/cell-normal.svg")
      css = "* { min-width: 14px; min-height: 14px; margin: 1px; padding: 0; }"
      tooltip = "bottom"
      loc(2,3)
      action[1] = Exec "/home/user/.local/bin/wlr-pager activate 7"
      action[ScrollUp] = Exec "/home/user/.local/bin/wlr-pager prev"
      action[ScrollDown] = Exec "/home/user/.local/bin/wlr-pager next"
    }
    image {
      value = If($PagerActive="right bottom","/home/user/.config/sfwbar/cell-focused.svg","/home/user/.config/sfwbar/cell-normal.svg")
      css = "* { min-width: 14px; min-height: 14px; margin: 1px; padding: 0; }"
      tooltip = "right bottom"
      loc(3,3)
      action[1] = Exec "/home/user/.local/bin/wlr-pager activate 8"
      action[ScrollUp] = Exec "/home/user/.local/bin/wlr-pager prev"
      action[ScrollDown] = Exec "/home/user/.local/bin/wlr-pager next"
    }
  }

  taskbar {
    style = "taskbar"
    rows = 1
    icons = true
    labels = true
    title_width = 30
    sort = false
    action[3] = Menu "winops"
  }

  label "spacer" {
    value = " "
    style = "spacer"
    action[3] = Exec "/home/user/.local/bin/panel-menu"
  }

  tray {
    style = "tray"
    rows = 1
  }

  label "volume" {
    style = "volume"
    interval = 500
    # Material Symbols ligatures: volume_off / volume_down / volume_up
    value = If(Volume("sink-mute"), "volume_off", If(Volume("sink-volume") < 50, "volume_down", "volume_up"))
    tooltip = If(Volume("sink-mute"), "muted", Str(Volume("sink-volume"),0) + "%")
    action[1] = Exec "pavucontrol"
    action[3] = Exec "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    action[ScrollUp] = Exec "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+"
    action[ScrollDown] = Exec "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  }

  grid "clock" {
    style = "clock"
    action[1] = Function "XCalPopUp"
    action[3] = Function "XCalPopUp"
    label "time" {
      style = "time"
      interval = 1000
      value = Time("%H:%M")
      loc(1,1)
      action[1] = Function "XCalPopUp"
      action[3] = Function "XCalPopUp"
    }
    label "date" {
      style = "date"
      interval = 1000
      value = Time("%Y-%m-%d")
      loc(1,2)
      action[1] = Function "XCalPopUp"
      action[3] = Function "XCalPopUp"
    }
  }
}

#CSS
window {
  background-color: rgba(0,0,0,1.0);
  font-family: "Inter Variable", "Inter", sans-serif;
  font-size: 12px;
  color: #eff0f1;
  -GtkWidget-direction: bottom;
}
image#launcher {
  min-width: 22px;
  min-height: 22px;
  padding: 0 5px;
  margin: 0 2px 0 3px;
}
image#launcher:hover {
  background-color: rgba(96,96,192,0.25);
}
grid#pager {
  margin: 0 4px 0 2px;
}
button#taskbar_item {
  background-image: none;
  background-color: #1a1a1a;
  border: none;
  border-radius: 0;
  box-shadow: none;
  padding: 0 8px;
  margin: 2px 1px;
}
button#taskbar_item label {
  color: #eff0f1;
}
button#taskbar_item.focused {
  background-color: rgba(96,96,192,0.4);
}
button#taskbar_item:hover {
  background-color: rgba(96,96,192,0.25);
}
#spacer {
  -GtkWidget-hexpand: true;
}
grid#tray {
  margin: 0 6px;
  -GtkWidget-valign: center;
}
grid#tray button,
button#tray_item,
button#tray_active,
button#tray_passive {
  background-image: none;
  background-color: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  padding: 2px;
  margin: 0 2px;
}
grid#tray image {
  min-width: 20px;
  min-height: 20px;
}
#volume {
  font-family: "Material Symbols Outlined";
  font-size: 18px;
  padding: 0 6px;
  -GtkWidget-valign: center;
}
grid#clock {
  padding: 0 10px;
  -GtkWidget-valign: center;
}
#time, #date {
  font-size: 10px;
  -GtkWidget-align: 0.5;
}
/* menus get their config name as CSS name; items are #menu_item */
#winops, #winops * {
  background-color: #101010;
  color: #eff0f1;
}
#menu_item:hover, #menu_item:hover * {
  background-color: #6060c0;
}
