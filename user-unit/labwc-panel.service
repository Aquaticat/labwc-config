# sfwbar panel for the labwc session.
# Bound to graphical-session.target so it starts and stops with the UWSM-managed session;
# the panel menu's "Restart panel" entry restarts this unit.
[Unit]
Description=Panel for labwc
Documentation=https://github.com/Aquaticat/labwc-config/blob/main/doc/troubleshooting/sfwbar-config-limits.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/sfwbar
Restart=on-failure
Slice=session-graphical.slice

[Install]
WantedBy=graphical-session.target
