# Clipboard history recorder for the labwc session.
# labwc-clipboard-pick reads the history this unit records;
# without it the picker has nothing to offer.
[Unit]
Description=Clipboard history recorder for labwc
Documentation=man:cliphist(1)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/wl-paste --watch /usr/bin/cliphist store
Restart=on-failure
RestartSec=1
Slice=session-graphical.slice

[Install]
WantedBy=graphical-session.target
