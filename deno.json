{
  "imports": {
    "@monochromatic-dev/module-logger": "npm:@monochromatic-dev/module-logger@^0.4.0",
    "@monochromatic-dev/module-test": "npm:@monochromatic-dev/module-test"
  },
  "tasks": {
    "test:unit": "deno run --allow-read --allow-run --allow-env --allow-sys test-support/run-unit-tests.ts installer helpers",
    "build:helpers": "deno run --allow-read --allow-write --allow-run --allow-env helpers/build.ts --out-dir helpers/dist"
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "npm:@monochromatic-dev/*"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true
  }
}
