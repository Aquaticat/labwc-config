# Installed as /etc/xdg/uwsm/env.d/labwc-config and sourced by uwsm when the graphical session starts.
# XDG_CONFIG_DIRS and XDG_DATA_DIRS come from /usr/lib/environment.d/50-labwc-config.conf instead,
# so the systemd user manager and its autostart generator see them too.

# Qt applications take the Breeze black color scheme through plasma-integration.
export QT_QPA_PLATFORMTHEME=kde
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export XCURSOR_THEME=breeze_cursors
export XCURSOR_SIZE=24

# X11 applications use xwayland-satellite on :12;
# labwc's own Xwayland is disabled by pointing wlroots at a path that does not exist.
export WLR_XWAYLAND=/nonexistent-labwc-config-xwayland-disabled
export DISPLAY=:12
# Java applications render blank windows under xwayland-satellite without this.
export _JAVA_AWT_WM_NONREPARENTING=1
